{
	"compatibility_date": "2026-05-30",
	"compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
	"name": "personal-blog",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "8f0b70d2662143009277b06994640a09"
		}
	],
	"observability": {
		"enabled": true
	}
}